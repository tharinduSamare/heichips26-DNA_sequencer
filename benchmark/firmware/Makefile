# ============================================================
# DNA Alignment Firmware
# ============================================================
#
# Build modes:
#
#   make
#       -> PicoRV32 + accelerator
#
#   make PROGRAM=acc
#       -> PicoRV32 + accelerator
#
#   make PROGRAM=sw
#       -> PicoRV32 + software-only
#
#   make PROGRAM=custom
#       -> Custom RISC-V core + accelerator
#          (uses assembly_generator.py)
#
# Generated files are stored in:
#
#   output/acc/
#   output/sw/
#   output/custom/
#
# ============================================================


# ============================================================
# Toolchain
# ============================================================

CROSS   ?= riscv64-unknown-elf-

CC      := $(CROSS)gcc
OBJCOPY := $(CROSS)objcopy
OBJDUMP := $(CROSS)objdump
SIZE    := $(CROSS)size


# ============================================================
# Build selection
# ============================================================

PROGRAM ?= acc


# ============================================================
# Output directory
# ============================================================

OUTPUT_DIR := output/$(PROGRAM)


# ============================================================
# Program configuration
# ============================================================

ifeq ($(PROGRAM),acc)

    MAIN_C    := dna_alignment_acc.c
    MAIN_NAME := dna_alignment_acc

else ifeq ($(PROGRAM),sw)

    MAIN_C    := dna_alignment_sw.c
    MAIN_NAME := dna_alignment_sw

else ifeq ($(PROGRAM),custom)

    # Custom RISC-V core firmware is generated by Python.
    MAIN_C    :=
    MAIN_NAME := custom

else

    $(error Unknown PROGRAM='$(PROGRAM)'. Use PROGRAM=acc, PROGRAM=sw, or PROGRAM=custom)

endif


# ============================================================
# RISC-V configuration
# ============================================================

ARCH := rv32i
ABI  := ilp32


# ============================================================
# Compiler flags
#
# Used only for PROGRAM=acc and PROGRAM=sw.
# ============================================================

CFLAGS := \
	-march=$(ARCH) \
	-mabi=$(ABI) \
	-Os \
	-ffreestanding \
	-fno-builtin \
	-nostdlib \
	-nostartfiles \
	-Wall \
	-Wextra

# Debug information is used for source-level disassembly.
# It is NOT used when generating the clean .s file.
DEBUG_CFLAGS := $(CFLAGS) -g


# ============================================================
# Linker flags
#
# Used only for PROGRAM=acc and PROGRAM=sw.
# ============================================================

LDFLAGS := \
	-march=$(ARCH) \
	-mabi=$(ABI) \
	-nostdlib \
	-nostartfiles \
	-T linker.ld


# ============================================================
# Toolchain-generated filenames
#
# Used only for PROGRAM=acc and PROGRAM=sw.
# ============================================================

MAIN_OBJ := $(MAIN_NAME).o
MAIN_S   := $(MAIN_NAME).s

OBJS := $(MAIN_OBJ) start.o


# ============================================================
# Default target
# ============================================================

all:
ifeq ($(PROGRAM),custom)
	$(MAKE) custom
else
	$(MAKE) toolchain
endif


# ============================================================
# PicoRV32 builds
#
# Used for:
#   PROGRAM=acc
#   PROGRAM=sw
# ============================================================

toolchain: $(OUTPUT_DIR)/firmware.hex \
           $(OUTPUT_DIR)/$(MAIN_S) \
           $(OUTPUT_DIR)/dna_accel.dis \
           $(OUTPUT_DIR)/dna_accel.lst

	@echo
	@echo "========================================"
	@echo "Build complete"
	@echo "========================================"
	@echo
	@echo "Program : $(PROGRAM)"
	@echo "Output  : $(OUTPUT_DIR)"
	@echo
	@echo "ELF     : $(OUTPUT_DIR)/dna_accel.elf"
	@echo "BIN     : $(OUTPUT_DIR)/firmware.bin"
	@echo "HEX     : $(OUTPUT_DIR)/firmware.hex"
	@echo "ASM     : $(OUTPUT_DIR)/$(MAIN_S)"
	@echo "DIS     : $(OUTPUT_DIR)/dna_accel.dis"
	@echo "LST     : $(OUTPUT_DIR)/dna_accel.lst"
	@echo
	@$(SIZE) $(OUTPUT_DIR)/dna_accel.elf
	@echo


# ============================================================
# Compile selected C file
#
# The object file is generated directly in the output directory.
# ============================================================

$(OUTPUT_DIR)/$(MAIN_OBJ): $(MAIN_C)
	@mkdir -p $(OUTPUT_DIR)
	$(CC) $(DEBUG_CFLAGS) -c $< -o $@


# ============================================================
# Generate clean assembly from selected C file
#
# No -g here, so the .s file remains clean.
# ============================================================

$(OUTPUT_DIR)/$(MAIN_S): $(MAIN_C)
	@mkdir -p $(OUTPUT_DIR)
	$(CC) $(CFLAGS) -S $< -o $@


# ============================================================
# Compile startup assembly
# ============================================================

$(OUTPUT_DIR)/start.o: start.S
	@mkdir -p $(OUTPUT_DIR)
	$(CC) $(DEBUG_CFLAGS) -c $< -o $@


# ============================================================
# Link
# ============================================================

$(OUTPUT_DIR)/dna_accel.elf: \
	$(OUTPUT_DIR)/$(MAIN_OBJ) \
	$(OUTPUT_DIR)/start.o \
	linker.ld

	$(CC) $(LDFLAGS) \
		$(OUTPUT_DIR)/$(MAIN_OBJ) \
		$(OUTPUT_DIR)/start.o \
		-o $@


# ============================================================
# ELF -> BIN
# ============================================================

$(OUTPUT_DIR)/firmware.bin: $(OUTPUT_DIR)/dna_accel.elf
	$(OBJCOPY) -O binary $< $@


# ============================================================
# BIN -> HEX
# ============================================================

$(OUTPUT_DIR)/firmware.hex: \
	$(OUTPUT_DIR)/firmware.bin \
	gen_mem_init.py

	python3 gen_mem_init.py \
		$(OUTPUT_DIR)/firmware.bin \
		$(OUTPUT_DIR)/firmware.hex


# ============================================================
# Normal disassembly
# ============================================================

$(OUTPUT_DIR)/dna_accel.dis: $(OUTPUT_DIR)/dna_accel.elf
	$(OBJDUMP) -d -M numeric $< > $@


# ============================================================
# Source-level disassembly
# ============================================================

$(OUTPUT_DIR)/dna_accel.lst: $(OUTPUT_DIR)/dna_accel.elf
	$(OBJDUMP) -S -d -M numeric $< > $@


# ============================================================
# Custom RISC-V core
#
# No RISC-V compiler/toolchain is required.
#
# assembly_generator.py is responsible for generating the
# firmware/assembly required by the custom core.
# ============================================================

custom:
	@mkdir -p $(OUTPUT_DIR)

	@echo
	@echo "========================================"
	@echo "Generating custom-core firmware"
	@echo "========================================"
	@echo

	python3 ./assembly_generator.py


# ============================================================
# Disassembly targets
#
# These are meaningful for the toolchain-based builds.
# ============================================================

dis:
	$(MAKE) toolchain


# ============================================================
# Assembly target
# ============================================================

asm:
ifeq ($(PROGRAM),custom)
	@echo "Custom core firmware is generated by assembly_generator.py"
else
	$(MAKE) $(OUTPUT_DIR)/$(MAIN_S)
endif


# ============================================================
# Clean
# ============================================================

clean:
	rm -rf output
	rm -f *.o *.elf *.bin *.hex *.dis *.lst *.s


# ============================================================
# Phony targets
# ============================================================

.PHONY: all toolchain custom dis asm clean
